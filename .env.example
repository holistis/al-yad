# Yad Motor — zet hier 1 EERLIJKE sleutel per provider (geen account-farming).
# Kopieer naar .env en vul in wat je hebt. Alles is optioneel; Ollama is de bodem.

# Tier 0 — gratis-cloud (failover-volgorde). Hoe meer je invult, hoe meer
# ademruimte voordat je tegen rate-limits (429) aanloopt bij langere taken.
GROQ_API_KEY=
CEREBRAS_API_KEY=
GEMINI_API_KEY=
GEMINI_API_KEY_2=
OPENROUTER_API_KEY=
# GitHub Models: aparte gratis pool (classic token, geen scopes nodig):
GITHUB_TOKEN=
# GITHUB_MODELS_MODEL=openai/gpt-4o-mini

# Halal-rem: GEMINI_API_KEY_3+ zijn BETAALD; alleen meenemen als dit true is.
ALLOW_PAID_GEMINI=false

# Tier 1 — betaald-waar-het-telt (managed-key / Pro-model). Leeg = uit.
# Voor zware/lange taken die de gratis tier niet trekken: vul YAD_PAID_API_KEY.
# YAD_PAID_PRIMARY=true -> betaald model EERST (beste kwaliteit op lastige sites, kost per stap).
# false/leeg -> betaald alleen als vangnet wanneer de gratis pool faalt (goedkoopst).
YAD_PAID_API_KEY=
YAD_PAID_BASE_URL=https://openrouter.ai/api/v1
YAD_PAID_MODEL=anthropic/claude-3.5-sonnet
YAD_PAID_PRIMARY=false

# Tier 2 — lokale bodem (Ollama), nooit "op" als hij draait:
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b-instruct

# ─────────────────────────────────────────────────────────────────────────────
# PRIVACY. Dit zijn de drie schakelaars die bepalen of er iets van jouw scherm
# naar buiten gaat. Ze stonden alleen in de broncode, dus alleen wie die las
# wist dat ze bestonden. Daarom staan ze hier nu met uitleg.
# ─────────────────────────────────────────────────────────────────────────────

# Alles op deze computer houden. Aan = 1 of "aan".
# Met deze stand wordt ELKE cloudprovider uit de keten gehaald, ook als vangnet.
# Yad gebruikt dan alleen het model dat bij jou draait. Faalt dat, dan faalt de
# taak zichtbaar in plaats van stilletjes door te schuiven naar de cloud.
# Let op: hij weigert te starten als OLLAMA_BASE_URL hierboven naar een andere
# computer wijst. Dat is met opzet, anders zou de belofte stil breken.
# Wat er zonder deze stand naar het model gaat: de volledige URL, 1500 tekens
# paginatekst, jouw opdracht, en bij vastlopen een schermafbeelding.
# Reken op ongeveer 15 seconden per denkstap in plaats van minder dan een
# seconde. Prima voor werk dat 's nachts loopt, merkbaar als je zit te wachten.
# YAD_LOKAAL=1

# Gedeeld herstelgeheugen. Standaard AAN.
# Loopt Yad vast op een site, dan vraagt hij een hint aan onze server en leert
# iedereen daarvan. Er gaan precies drie dingen heen: de hostnaam (dus
# "portaal.leverancier.nl", zonder pad en zonder parameters), het soort storing,
# en het soort actie. Geen pagina-inhoud, geen ingevulde velden, geen URL.
# Uitzetten:
# YAD_HERSTELBREIN=uit

# Controle op een nieuwe versie. Standaard AAN, maar wordt alleen uitgevoerd als
# je er zelf om vraagt. Haalt een versiebestand op en vergelijkt lokaal; er gaat
# niets over jou mee, behalve wat elk internetverzoek nu eenmaal prijsgeeft
# (je IP-adres en het tijdstip).
# YAD_UPDATE_CHECK=uit

# Optionele model-overrides:
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_MODEL=gemini-2.0-flash
