{
  "name": "yad-agent-mcp",
  "version": "0.1.0",
  "description": "MCP server that lets an AI agent (Claude Code, Cursor, etc.) drive Yad, a local browser-automation companion, over its existing local HTTP API.",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "yad-agent-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "browser-automation",
    "ai-agent",
    "claude-code"
  ],
  "author": "Abdellah Ouadoudi",
  "license": "MIT",
  "homepage": "https://yadagent.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/holistis/al-yad.git",
    "directory": "packages/mcp-server"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('fs').chmodSync('dist/index.js', 0o755)\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
