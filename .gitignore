# lokale, machine-specifieke extensie-sleutel (mag NOOIT de repo in)
*.pem
secrets/
packages/extension/.keys/
# gegenereerde, machine-specifieke host-bestanden (absolute paden) -> per machine via pnpm setup-host
native-messaging/com.yad.companion.json
native-messaging/yad-companion-launcher.bat
# benchmark-resultaten (te groot voor repo; enkel de definitieve bewaar je)
data/benchmark-results-*.json
# run-history en action-cache (machine-specifiek, in alle subdirectories)
**/data/run-history.jsonl
**/data/action-cache.json
**/data/recovery-store.jsonl
# externe-toegang audit-log (machine-specifiek, kan gevoelige IP's bevatten)
**/data/external-audit.jsonl
# lokale SSH-sleutel voor ollama-tunnel (mag NOOIT de repo in)
ollama_key
ollama_key.pub

# Winkelbuild (aparte map zodat hij de werkversie niet overschrijft)
.output-winkel/

# Chrome Web Store API geheimen (nooit committen)
webstore-secrets.json
yad-winkel-upload.zip
data/recovery-store.jsonl

# Bouwsels en winkel-uploads. Deze stonden untracked in de werkmap, waaronder
# een installer van 91 MB, en werden bij een `git add -A` in een docs-commit
# meegesleept. GitHub waarschuwt vanaf 50 MB en weigert boven 100 MB, dus dat
# is niet alleen rommelig maar breekt op termijn de push.
companion-dist/
dist-exe/
yad-winkel-*.zip

# Winkel-materiaal en schermafbeeldingen, horen bij de store-listing en niet
# in de geschiedenis van de code.
store-promo-*.png
store-shot-*.png
yadagent.jpg

# Lokale draai-data en experimenten van een enkele machine.
data/judge-safety-*.json
data/judge-safety-*.jsonl
data/browser-use-compare-*.json
ollama-tunnel*.ps1
ollama-tunnel*.bat
ollama-tunnel*.py
setup-ollama-key.py
launcher-debug.log
