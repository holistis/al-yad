{
  "name": "al-yad",
  "version": "0.1.0",
  "description": "Self-hostable, privacy-first AI browser automation agent — works inside your real logged-in Chrome session",
  "homepage": "https://yadagent.com",
  "author": "AO Services",
  "license": "MIT",
  "private": false,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "check-licenses": "tsx scripts/check-licenses.ts",
    "setup-host": "tsx scripts/setup-native-host.ts",
    "register-host": "powershell -ExecutionPolicy Bypass -File scripts/register-host.ps1",
    "smoke-host": "tsx scripts/smoke-native-host.ts",
    "engine-smoke": "tsx scripts/engine-smoke.ts",
    "process-legal": "tsx scripts/process-legal.ts",
    "test-rejection": "tsx scripts/test-done-rejection.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "benchmark:research": "tsx scripts/benchmark.ts --category web-research",
    "benchmark:quick": "tsx scripts/benchmark.ts --limit 5 --delay 10",
    "benchmark:full": "tsx scripts/benchmark.ts --delay 90",
    "benchmark:batch1": "tsx scripts/benchmark.ts --limit 8 --delay 60",
    "benchmark:batch2": "tsx scripts/benchmark.ts --from 9 --limit 8 --delay 60",
    "robustness-nav-hijack": "tsx scripts/robustness-nav-hijack.ts",
    "benchmark:batch3": "tsx scripts/benchmark.ts --from 17 --delay 60",
    "benchmark:auth": "tsx scripts/benchmark.ts --tasks data/benchmark-tasks-auth.jsonl --delay 30",
    "benchmark:extended": "tsx scripts/benchmark.ts --tasks data/benchmark-tasks-extended.jsonl --delay 30",
    "deploy-server": "bash scripts/deploy-server.sh"
  },
  "devDependencies": {
    "marked": "^12.0.2",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  }
}
